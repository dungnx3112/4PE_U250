# Copy this file to run_inference.env and update the paths once.
# After that, run: ./run_inference.sh path/to/design.xclbin

# Usually auto-detected as ./decode_host. Uncomment only to override it.
# HOST_BIN=/absolute/path/to/decode_host
DATA_DIR=/dev/shm/4PE_U250_dense
DEVICE=0000:13:00.0

# Optional defaults:
# PROMPT=Hello
# MAX_TOKENS=32
# REPEAT_PENALTY=1.1
# TEMPERATURE=0
# TOP_P=0.9
# SEED=42
# LOG_DIR=/absolute/path/to/log/directory
