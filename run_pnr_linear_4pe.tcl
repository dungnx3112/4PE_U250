set script_dir [file dirname [file normalize [info script]]]
set output_dir [file join $script_dir "pnr_linear_4pe_run"]
file mkdir $output_dir
cd $output_dir

# 1. Read all Verilog files generated by HLS
set verilog_files [glob [file join $script_dir "proj_int4_linear_4pe/solution_270mhz/impl/verilog/*.v"]]
puts "INFO: Reading [llength $verilog_files] Verilog files..."
read_verilog $verilog_files

set ip_verilog_files [glob -nocomplain [file join $script_dir "proj_int4_linear_4pe/solution_270mhz/impl/ip/hdl/ip/*.v"]]
if {[llength $ip_verilog_files] > 0} {
    puts "INFO: Reading [llength $ip_verilog_files] IP wrapper Verilog files..."
    read_verilog $ip_verilog_files
}

# 2. Read all XCI IP files generated by HLS
set xci_files [glob -nocomplain [file join $script_dir "proj_int4_linear_4pe/solution_270mhz/impl/ip/tmp.srcs/sources_1/ip/*/*.xci"]]
if {[llength $xci_files] > 0} {
    puts "INFO: Reading [llength $xci_files] IP core XCI files..."
    read_ip $xci_files
    generate_target {synthesis} [get_ips]
}

# 3. Synthesize Design (Out of Context on xcu250)
puts "INFO: Starting OOC Synthesis for int4_linear_kernel_4pe on xcu250-figd2104-2L-e..."
synth_design -top int4_linear_kernel_4pe -part xcu250-figd2104-2L-e -mode out_of_context

# 4. Create Clock Constraint: 3.703 ns = 270 MHz
puts "INFO: Applying clock constraint: 3.703 ns (270 MHz)..."
create_clock -period 3.703 -name ap_clk [get_ports ap_clk]

# 5. Create 4-SLR Floorplan Pblocks
puts "INFO: Creating 4-SLR Floorplan Pblocks..."
create_pblock pblock_SLR0
resize_pblock pblock_SLR0 -add [get_slrs SLR0]

create_pblock pblock_SLR1
resize_pblock pblock_SLR1 -add [get_slrs SLR1]

create_pblock pblock_SLR2
resize_pblock pblock_SLR2 -add [get_slrs SLR2]

create_pblock pblock_SLR3
resize_pblock pblock_SLR3 -add [get_slrs SLR3]

# Assign PE0 to SLR0
set pe0_cells [get_cells -hierarchical -filter {NAME =~ *compute_0* || NAME =~ *store_local_output_0* || NAME =~ *gmem0*}]
if {[llength $pe0_cells] > 0} {
    add_cells_to_pblock [get_pblocks pblock_SLR0] $pe0_cells
    puts "INFO: Pblock SLR0: assigned [llength $pe0_cells] cells"
}

# Assign PE1 + Reducer01 + Finalizer01 to SLR1
set pe1_cells [get_cells -hierarchical -filter {NAME =~ *compute_1* || NAME =~ *store_local_output_1* || NAME =~ *reduce_pair_and_route_0* || NAME =~ *finalize_pair_outputs_0* || NAME =~ *gmem1*}]
if {[llength $pe1_cells] > 0} {
    add_cells_to_pblock [get_pblocks pblock_SLR1] $pe1_cells
    puts "INFO: Pblock SLR1: assigned [llength $pe1_cells] cells"
}

# Assign PE2 + Reducer23 + Finalizer23 to SLR2
set pe2_cells [get_cells -hierarchical -filter {NAME =~ *compute_2* || NAME =~ *store_local_output_2* || NAME =~ *reduce_pair_and_route_1* || NAME =~ *finalize_pair_outputs_1* || NAME =~ *gmem2*}]
if {[llength $pe2_cells] > 0} {
    add_cells_to_pblock [get_pblocks pblock_SLR2] $pe2_cells
    puts "INFO: Pblock SLR2: assigned [llength $pe2_cells] cells"
}

# Assign PE3 to SLR3
set pe3_cells [get_cells -hierarchical -filter {NAME =~ *compute_3* || NAME =~ *store_local_output_3* || NAME =~ *gmem3*}]
if {[llength $pe3_cells] > 0} {
    add_cells_to_pblock [get_pblocks pblock_SLR3] $pe3_cells
    puts "INFO: Pblock SLR3: assigned [llength $pe3_cells] cells"
}

# 6. Implementation pipeline
puts "INFO: Running opt_design..."
opt_design

puts "INFO: Running place_design with SSI_SpreadSLLs..."
place_design -directive SSI_SpreadSLLs

puts "INFO: Running phys_opt_design (pre-route)..."
phys_opt_design -directive AggressiveExplore

puts "INFO: Running route_design (Explore)..."
route_design -directive Explore

puts "INFO: Running post-route phys_opt_design..."
phys_opt_design -directive AggressiveExplore

# 7. Reports
puts "INFO: Generating timing and utilization reports..."
report_timing_summary -file timing_summary_270mhz.rpt
report_utilization -file utilization.rpt

write_checkpoint -force int4_linear_kernel_4pe_routed.dcp

set wns [get_property SLACK [get_timing_paths -max_paths 1 -setup]]
puts "=================================================="
puts "FINAL RESULT: Worst Negative Slack (WNS) = $wns ns"
if {$wns >= 0.0} {
    puts "TIMING CLOSED: Matmul 4-PE successfully achieved >250MHz (270MHz)!"
} else {
    puts "TIMING VIOLATED: WNS = $wns ns at 270MHz"
}
puts "=================================================="

exit